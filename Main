local LIB_URL = "https://raw.githubusercontent.com/Aipplazz2017/Xerm/main/ui_library.lua"

local WINDOW_CONFIG = {
	Title = "1yui discrod",
	Subtitle = "WarZ PvP + Ultimate Boost",
	Width = 440,
	Height = 290,
}

local function notify(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "1yui discrod", Text = tostring(text), Duration = 5,
		})
	end)
	warn("[1yui]", text)
end

local okGet, src = pcall(function() return game:HttpGet(LIB_URL) end)
if not okGet then notify("Failed to load UI Library") return end

local loadFn, compileErr = loadstring(src)
if not loadFn then notify("UI Compile Error: " .. tostring(compileErr)) return end

local okLib, Library = pcall(loadFn)
if not okLib or type(Library) ~= "table" then notify("Failed to initialize Library") return end

local okWin, Window = pcall(Library.new, WINDOW_CONFIG)
if not okWin then notify("Failed to create Window") return end

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

pcall(function()
	settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 1e6
	Lighting.Brightness = 2
	Lighting.ClockTime = 14
	Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
	Lighting.Ambient = Color3.fromRGB(255, 255, 255)
	
	local function clearFog(parent)
		for _, v in pairs(parent:GetDescendants()) do
			if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
				v:Destroy()
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
				v.Enabled = false
			end
		end
	end
	
	clearFog(Lighting)
	clearFog(Workspace)
	
	Workspace.DescendantAdded:Connect(function(v)
		if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("BlurEffect") then
			v:Destroy()
		elseif v:IsA("ParticleEmitter") or v:IsA("Smoke") then
			v.Enabled = false
		end
	end)
	
	for _, v in pairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Material = Enum.Material.SmoothPlastic
			v.CastShadow = false
		end
	end
end)

local function optimizeDistance(v)
	if v:IsA("BasePart") and not v:IsDescendantOf(LocalPlayer.Character) then
		task.spawn(function()
			while v and v.Parent do
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (v.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
					if dist > 200 then
						v.LocalTransparencyModifier = 1
					else
						v.LocalTransparencyModifier = 0
					end
				end
				task.wait(1)
			end
		end)
	end
end

for _, v in ipairs(Workspace:GetDescendants()) do
	optimizeDistance(v)
end

local RECOIL_FIELDS = {
	"Recoil", "RecoilUp", "RecoilLeft", "RecoilRight",
	"CameraKick", "CameraKickUp", "CameraKickHorizontal",
	"VisualRecoil", "AimRecoilMultiplier",
	"Spread", "MinSpread", "MaxSpread", "BaseSpread"
}

task.spawn(function()
	while task.wait(0.5) do
		if getgc then
			for _, v in pairs(getgc(true)) do
				if type(v) == "table" then
					for _, key in ipairs(RECOIL_FIELDS) do
						if rawget(v, key) ~= nil then
							rawset(v, key, 0)
						end
					end
				end
			end
		end
	end
end)

local ammoConnection = nil
local function bindAmmoCheck(tool)
	if not tool then return end
	local ammoObj = tool:FindFirstChild("Ammo") or tool:FindFirstChild("CurrentAmmo") or tool:FindFirstChild("Clip")
	if ammoObj and ammoObj:IsA("ValueBase") then
		if ammoConnection then ammoConnection:Disconnect() end
		ammoConnection = ammoObj.Changed:Connect(function(newValue)
			if newValue <= 0 then
				local remotes = ReplicatedStorage:FindFirstChild("Remotes")
				local reloadRemote = remotes and remotes:FindFirstChild("ReloadRequest")
				if reloadRemote then reloadRemote:FireServer() end
			end
		end)
	end
end

_G.AutoCombine = true
task.spawn(function()
	while _G.AutoCombine do
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local combineRemote = remotes and remotes:FindFirstChild("CombineMags")
		if combineRemote then
			combineRemote:FireServer(3)
		end
		task.wait(5)
	end
end)

task.spawn(function()
	while task.wait(1) do
		pcall(function()
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local pickupRemote = remotes and remotes:FindFirstChild("PickupLoot")
			if pickupRemote then
				pickupRemote:FireServer("e737c581-37d5-45a0-9775-7c5da760321a", "prep", 12)
				pickupRemote:FireServer("e737c581-37d5-45a0-9775-7c5da760321a", "use", 12)
			end
			for _, sound in ipairs(Workspace:GetDescendants()) do
				if sound:IsA("Sound") and not sound:IsDescendantOf(LocalPlayer.Character) then
					sound.Volume = 0
					sound.Playing = false
				end
			end
		end)
	end
end)

local TURN_SPEED = 85
local CAMERA_SENSITIVITY = 3.5

local function applySensitivity()
	UserInputService.MouseDeltaSensitivity = CAMERA_SENSITIVITY
end
applySensitivity()
UserInputService:GetPropertyChangedSignal("MouseDeltaSensitivity"):Connect(applySensitivity)

local function setupFastTurn(char)
	local humanoid = char:WaitForChild("Humanoid", 10)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not hrp then return end

	humanoid.AutoRotate = false

	local connection
	connection = RunService.RenderStepped:Connect(function(deltaTime)
		if not char:IsDescendantOf(Workspace) or humanoid.Health <= 0 then
			connection:Disconnect()
			return
		end

		if humanoid.MoveDirection.Magnitude > 0.1 then
			local lookVector = Camera.CFrame.LookVector
			local moveAngle = math.atan2(humanoid.MoveDirection.X, humanoid.MoveDirection.Z)
			local targetRotation = CFrame.Angles(0, moveAngle, 0)
			local targetCFrame = CFrame.new(hrp.Position) * targetRotation
			hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, math.clamp(TURN_SPEED * deltaTime, 0, 1))
		end
	end)
end

local MULTIPLIER = 1.06
local BASE_SPEED = 16

local function setupSpeedBoost(char)
	local humanoid = char:WaitForChild("Humanoid", 10)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not hrp then return end

	local connection
	connection = RunService.RenderStepped:Connect(function(deltaTime)
		if not char:IsDescendantOf(Workspace) or humanoid.Health <= 0 then
			connection:Disconnect()
			return
		end

		if humanoid.MoveDirection.Magnitude > 0.1 then
			if humanoid.WalkSpeed <= 8 then return end
			local extraSpeed = (BASE_SPEED * (MULTIPLIER - 1)) * deltaTime
			hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection.Unit * extraSpeed)
		end
	end)
end

local function onCharacterAdded(char)
	task.wait(0.2)
	setupFastTurn(char)
	setupSpeedBoost(char)
	
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then bindAmmoCheck(child) end
	end)
	
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") then bindAmmoCheck(child) end
	end
end

if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

local function createHealthESP(character)
	if not character or character == LocalPlayer.Character then return end
	local head = character:WaitForChild("Head", 5)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not head or not humanoid or head:FindFirstChild("HealthESP_Gui") then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "HealthESP_Gui"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 100, 0, 10)
	billboard.StudsOffset = Vector3.new(0, 2, 0)
	billboard.AlwaysOnTop = true

	local healthBG = Instance.new("Frame")
	healthBG.Parent = billboard
	healthBG.Size = UDim2.new(1, 0, 1, 0)
	healthBG.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	healthBG.BorderSizePixel = 1

	local healthBar = Instance.new("Frame")
	healthBar.Name = "HealthBar"
	healthBar.Parent = healthBG
	healthBar.Size = UDim2.new(1, 0, 1, 0)
	healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
	healthBar.BorderSizePixel = 0

	billboard.Parent = head

	local function updateHealth()
		local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		healthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
		if healthPercent > 0.5 then
			healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
		elseif healthPercent > 0.25 then
			healthBar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
		else
			healthBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
		end
	end

	humanoid.HealthChanged:Connect(updateHealth)
	updateHealth()
end

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		if player.Character then createHealthESP(player.Character) end
		player.CharacterAdded:Connect(function(char) createHealthESP(char) end)
	end
end
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char) createHealthESP(char) end)
end)

local ITEM_NAME = "BandagesDX"
local HEALTH_THRESHOLD = 0.74
local ITEM_COOLDOWN = 0.03
local isHealing = false

local function bindHealthCheck(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end

	local function checkAndHeal()
		if isHealing then return end
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local useItemRemote = remotes and remotes:FindFirstChild("UseItem")
		if not useItemRemote then return end

		if humanoid.Health > 0 and (humanoid.Health / humanoid.MaxHealth) <= HEALTH_THRESHOLD then
			isHealing = true
			while humanoid.Health > 0 and (humanoid.Health / humanoid.MaxHealth) <= HEALTH_THRESHOLD do
				useItemRemote:FireServer(3, ITEM_NAME, nil, nil, true)
				task.wait(ITEM_COOLDOWN)
			end
			isHealing = false
		end
	end

	task.spawn(checkAndHeal)
	humanoid.HealthChanged:Connect(checkAndHeal)
end

if LocalPlayer.Character then task.spawn(bindHealthCheck, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(bindHealthCheck)

local Info = Window.CreateTab("Info", "Info")
Info.Section("System Status")
Info.Label("🟢 No Recoil & Auto Reload : Running")
Info.Label("🟢 Auto Combine & Auto Heal : Running")
Info.Label("🟢 WarZ Turn & Speed Boost : Running")
Info.Label("🟢 FPS Boost & Health ESP : Running")

local Home = Window.CreateTab("Home", "Home")
Window.AddFPSStat(Home, "Current FPS")

Home.Section("Server Control")
Home.Button("Rejoin", function()
	local TeleportService = game:GetService("TeleportService")
	if #Players:GetPlayers() <= 1 then
		TeleportService:Teleport(game.PlaceId, LocalPlayer)
	else
		TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
	end
end)

Home.Button("Server Hop", function()
	local TeleportService = game:GetService("TeleportService")
	local HttpService = game:GetService("HttpService")
	local success, result = pcall(function()
		return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Asc&limit=100"))
	end)
	if success and result and result.data then
		for _, server in ipairs(result.data) do
			if server.id ~= game.JobId and server.playing < server.maxPlayers then
				TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
				return
			end
		end
	end
	TeleportService:Teleport(game.PlaceId, LocalPlayer)
end)

Window.AddSettingsTab("Settings")
notify("Loaded successfully")
