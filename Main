local LIB_URL = "https://raw.githubusercontent.com/Aipplazz2017/Xerm/main/ui_library.lua"

local WINDOW_CONFIG = {
    Title = "1yui discrod",
    Subtitle = " by 1yui ",
    Width = 440,
    Height = 290,
}

local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "1yui WarZ", Text = tostring(text), Duration = 5,
        })
    end)
    warn("[1yui WarZ]", text)
end

local okGet, src = pcall(function() return game:HttpGet(LIB_URL) end)
if not okGet then notify("Failed to load UI Library") return end

local loadFn, compileErr = loadstring(src)
if not loadFn then notify("UI Compile Error: " .. tostring(compileErr)) return end

local okLib, Library = pcall(loadFn)
if not okLib or type(Library) ~= "table" then notify("Failed to initialize Library") return end

local okWin, Window = pcall(Library.new, WINDOW_CONFIG)
if not okWin then notify("Failed to create Window") return end

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local plr = Players.LocalPlayer
local cam = Workspace.CurrentCamera

-- FPS & Lighting
if setfpscap then setfpscap(120) end

pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e6
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    
    local function clearAtmosphere(p)
        for _, v in pairs(p:GetDescendants()) do
            if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
                v:Destroy()
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
                v.Enabled = false
            elseif v:IsA("Sound") and not v:IsDescendantOf(plr.Character) then
                v.Volume = 0
                v.Playing = false
            end
        end
    end
    
    clearAtmosphere(Lighting)
    clearAtmosphere(Workspace)
end)

-- Auto Reload
local ammoConn = nil
local function bindAmmo(tool)
    if not tool then return end
    local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("CurrentAmmo") or tool:FindFirstChild("Clip")
    if ammo and ammo:IsA("ValueBase") then
        if ammoConn then ammoConn:Disconnect() end
        ammoConn = ammo.Changed:Connect(function(val)
            if val <= 0 then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local reload = remotes and remotes:FindFirstChild("ReloadRequest")
                if reload then reload:FireServer() end
            end
        end)
    end
end

-- No Recoil & Range
local rFields = {"Recoil", "RecoilUp", "RecoilLeft", "RecoilRight", "CameraKick", "CameraKickUp", "CameraKickHorizontal", "VisualRecoil", "AimRecoilMultiplier", "Spread", "MinSpread", "MaxSpread", "BaseSpread"}
local rngFields = {"Range", "MaxDistance", "Distance", "BulletRange", "FireRange", "MaxRange", "BulletDistance"}

task.spawn(function()
    while task.wait(5) do
        if getgc then
            pcall(function()
                for _, v in pairs(getgc(true)) do
                    if type(v) == "table" then
                        for _, k in ipairs(rFields) do
                            if rawget(v, k) ~= nil then rawset(v, k, 0) end
                        end
                        for _, k in ipairs(rngFields) do
                            local val = rawget(v, k)
                            if val ~= nil and type(val) == "number" and val > 0 and val < 1500 then
                                rawset(v, k, 1500)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Fast Turn & Speed
local turnSpeed = 85
local sens = 3.5
local mult = 1.06
local baseSpd = 16

UserInputService.MouseDeltaSensitivity = sens
UserInputService:GetPropertyChangedSignal("MouseDeltaSensitivity"):Connect(function()
    UserInputService.MouseDeltaSensitivity = sens
end)

local function setupChar(char)
    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not hum or not hrp then return end
    
    hum.AutoRotate = false
    
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not char:IsDescendantOf(Workspace) or hum.Health <= 0 then
            conn:Disconnect()
            return
        end
        
        if hum.MoveDirection.Magnitude > 0.1 then
            local angle = math.atan2(hum.MoveDirection.X, hum.MoveDirection.Z)
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position) * CFrame.Angles(0, angle, 0), math.clamp(turnSpeed * dt, 0, 1))
            
            if hum.WalkSpeed > 8 then
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection.Unit * (baseSpd * (mult - 1)) * dt)
            end
        end
    end)
end

local function onCharAdded(char)
    task.wait(0.2)
    setupChar(char)
    char.ChildAdded:Connect(function(c) if c:IsA("Tool") then bindAmmo(c) end end)
    for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") then bindAmmo(c) end end
end

if plr.Character then onCharAdded(plr.Character) end
plr.CharacterAdded:Connect(onCharAdded)

-- Health ESP
local function addESP(char)
    if not char or char == plr.Character then return end
    local head = char:WaitForChild("Head", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not head or not hum or head:FindFirstChild("ESP") then return end

    local bb = Instance.new("BillboardGui", head)
    bb.Name = "ESP"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 80, 0, 8)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.AlwaysOnTop = true

    local bg = Instance.new("Frame", bb)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    bg.BorderSizePixel = 0

    local bar = Instance.new("Frame", bg)
    bar.Size = UDim2.new(1, 0, 1, 0)
    bar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    bar.BorderSizePixel = 0

    hum.HealthChanged:Connect(function()
        bar.Size = UDim2.new(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= plr then
        if p.Character then addESP(p.Character) end
        p.CharacterAdded:Connect(addESP)
    end
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(addESP)
end)

-- Auto Heal
local itemName = "BandagesDX"
local threshold = 0.74
local cooldown = 0.003
local healing = false

local args = { [1] = 3, [2] = itemName, [3] = nil, [4] = nil, [5] = true, n = 5 }

local function bindHeal(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    local function runHeal()
        if healing then return end
        if hum.Health > 0 and (hum.Health / hum.MaxHealth) <= threshold then
            healing = true
            local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("UseItem")
            while hum.Health > 0 and (hum.Health / hum.MaxHealth) <= threshold do
                if remote then remote:FireServer(unpack(args, 1, args.n)) end
                task.wait(cooldown)
            end
            healing = false
        end
    end

    task.spawn(runHeal)
    hum.HealthChanged:Connect(runHeal)
end

if plr.Character then task.spawn(bindHeal, plr.Character) end
plr.CharacterAdded:Connect(bindHeal)

-- UI Setup
local Info = Window.CreateTab("Info", "Info")
Info.Section("Status System")
Info.Label("Auto Reload : Active")
Info.Label("No Recoil & Range (1500) : Active")
Info.Label("Speed Boost & Fast Turn : Active")
Info.Label("FPS Boost 120 : Active")
Info.Label("Auto Heal : Active")

local Home = Window.CreateTab("Home", "Home")
Window.AddFPSStat(Home, "Current FPS")

Home.Section("Server Control")
Home.Button("Rejoin", function()
    if #Players:GetPlayers() <= 1 then
        TeleportService:Teleport(game.PlaceId, plr)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, plr)
    end
end)

Home.Button("Server Hop", function()
    local success, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Asc&limit=100"))
    end)
    if success and res and res.data then
        for _, s in ipairs(res.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, plr)
                return
            end
        end
    end
    TeleportService:Teleport(game.PlaceId, plr)
end)

Window.AddSettingsTab("Settings")
notify("WarZ Optimized Script Ready!")
